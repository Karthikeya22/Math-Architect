{
  "name": "florida-b.e.s.t.-math-architect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --platform=node --packages=external --external:node-geogebra --external:puppeteer --bundle --format=cjs --outfile=dist/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit && vite build --mode development",
    "start": "node dist/server.cjs",
    "ab:evaluate": "node scripts/run-ab-eval.mjs",
    "test": "vitest run",
    "extract:standards": "tsx scripts/extract-best-standards.ts",
    "extract:khan-mappings": "tsx scripts/parse-best-math-mappings.ts",
    "seed:practice-links": "tsx scripts/seed_standard_practice_links.ts",
    "seed:question-materials": "tsx scripts/seed_question_materials.ts",
    "report:visual-paths": "tsx scripts/report_visual_paths.ts",
    "db:gen-types": "npx supabase@latest gen types typescript --linked > src/types/database.generated.ts"
  },
  "dependencies": {
    "@amcharts/amcharts5": "^5.17.2",
    "@google/genai": "^1.38.0",
    "@supabase/supabase-js": "^2.105.0",
    "@tailwindcss/vite": "^4.2.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "express": "^5.2.1",
    "html2canvas": "1.4.1",
    "jspdf": "^4.2.1",
    "katex": "^0.16.21",
    "lucide-react": "^0.563.0",
    "motion": "^12.38.0",
    "node-geogebra": "^1.3.2",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "3.12.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.5"
  }
}
