{
  "name": "florida-b.e.s.t.-math-architect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --platform=node --packages=external --external:node-geogebra --external:puppeteer --bundle --format=esm --outfile=dist/server.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit && vite build --mode development",
    "start": "node dist/server.mjs",
    "ab:evaluate": "node scripts/run-ab-eval.mjs",
    "test": "vitest run",
    "extract:standards": "tsx scripts/extract-best-standards.ts",
    "extract:khan-mappings": "tsx scripts/parse-best-math-mappings.ts",
    "seed:practice-links": "tsx scripts/seed_standard_practice_links.ts",
    "seed:question-materials": "tsx scripts/seed_question_materials.ts",
    "audit:figures": "tsx scripts/audit-figures.ts",
    "report:visual-paths": "tsx scripts/report_visual_paths.ts",
    "figures:matrix": "tsx scripts/classify-standard-figures.ts",
    "figures:skeletons": "tsx scripts/build-figure-skeletons.ts",
    "figures:fixtures": "tsx scripts/build-standard-figure-fixtures.ts",
    "figures:audit:fixtures": "tsx scripts/audit-standard-fixtures.ts",
    "figures:audit:generated": "tsx scripts/audit-generated-figures.ts",
    "figures:audit": "npm run figures:audit:fixtures && npm run figures:audit:generated",
    "figures:build": "npm run figures:matrix && npm run figures:skeletons && npm run figures:fixtures && npm run figures:audit",
    "lc:enrich": "tsx scripts/enrich_lc_math_components.ts",
    "lc:smoke": "tsx scripts/verify_lc_shadow.ts",
    "db:gen-types": "npx supabase@latest gen types typescript --linked > src/types/database.generated.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.81",
    "@ai-sdk/google": "^4.0.98",
    "@ai-sdk/openai": "^4.0.95",
    "@amcharts/amcharts5": "^5.17.2",
    "@google/genai": "^1.38.0",
    "@learning-commons/evaluators": "^1.2.0",
    "@supabase/supabase-js": "^2.105.0",
    "@tailwindcss/vite": "^4.2.4",
    "ai": "^7.0.142",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "express": "^5.2.1",
    "html2canvas": "1.4.1",
    "jspdf": "^4.2.1",
    "katex": "^0.16.21",
    "lucide-react": "^0.563.0",
    "motion": "^12.38.0",
    "node-geogebra": "^1.3.2",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "3.12.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.5"
  }
}
